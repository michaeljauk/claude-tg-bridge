# claude-tg-bridge configuration
# Copy to ~/.claude-tg-bridge/env and chmod 600

# REQUIRED: Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=PUT_YOUR_BOT_TOKEN_HERE

# REQUIRED: comma-separated Telegram user IDs that may chat with this bot
# Get yours from @userinfobot
TELEGRAM_ALLOWLIST=12345678

# OPTIONAL: full path to claude CLI (falls back to $PATH)
# CLAUDE_BIN=/usr/local/bin/claude

# OPTIONAL: model alias passed to --model
CLAUDE_MODEL=sonnet

# OPTIONAL: working dir for the claude subprocess (where it discovers CLAUDE.md)
# CLAW_WORK_DIR=/home/you/notes

# OPTIONAL: where to keep state.json + USER.md
# CLAW_STATE_DIR=/home/you/.claude-tg-bridge

# OPTIONAL: subprocess timeout in seconds
CLAUDE_TIMEOUT_SEC=600

# OPTIONAL: max concurrent turns processed in parallel
# Each turn spawns one claude --print subprocess. Higher values let you fire
# follow-up messages while a long task is still running. Trade-off: parallel
# turns starting from the same chat both --resume the latest known session_id
# and the last one to finish wins the next state.json write — so the session
# can fork and lose one branch's short-term context. Set to 1 to serialize.
CLAW_MAX_CONCURRENT=8
