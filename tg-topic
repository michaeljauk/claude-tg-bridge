#!/bin/bash
# tg-topic — manage Telegram forum topics from inside the claude subprocess.
#
# Designed to live alongside tg-notify in ~/bin. Reads bot token from
# ~/.claude-tg-bridge/env (or $CLAW_STATE_DIR/env) and the supergroup
# chat_id from state.json's _group_chat_id (auto-populated by the bridge
# on the first message it sees from a supergroup).
#
# Subcommands:
#   tg-topic create "<name>"           creates a topic, prints thread_id
#   tg-topic post --thread <id> "<txt>"  posts plain text into a topic
#   tg-topic list                      lists known topic sessions
#   tg-topic close --thread <id>       closes a topic (state kept)
#
# Errors go to stderr; stdout is parseable.

set -euo pipefail

STATE_DIR="${CLAW_STATE_DIR:-$HOME/.claude-tg-bridge}"
ENV_FILE="$STATE_DIR/env"
STATE_FILE="$STATE_DIR/state.json"

[ -f "$ENV_FILE" ] || { echo "tg-topic: missing $ENV_FILE" >&2; exit 1; }
# shellcheck disable=SC1090
set -a; . "$ENV_FILE"; set +a
: "${TELEGRAM_BOT_TOKEN:?TELEGRAM_BOT_TOKEN not set in $ENV_FILE}"

CHAT_ID=""
if [ -f "$STATE_FILE" ]; then
  CHAT_ID=$(jq -r '._group_chat_id // empty' "$STATE_FILE")
fi
if [ -z "$CHAT_ID" ] && [ -n "${CLAW_GROUP_CHAT_ID:-}" ]; then
  CHAT_ID="$CLAW_GROUP_CHAT_ID"
fi
[ -n "$CHAT_ID" ] || {
  echo "tg-topic: no group chat_id known (post once in the supergroup so the bridge caches it, or set CLAW_GROUP_CHAT_ID)" >&2
  exit 1
}

API="https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}"

case "${1:-}" in
  create)
    name="${2:-}"
    [ -n "$name" ] || { echo "tg-topic: name required" >&2; exit 1; }
    res=$(curl -fsS "$API/createForumTopic" \
      --data-urlencode "chat_id=$CHAT_ID" \
      --data-urlencode "name=$name")
    ok=$(jq -r '.ok' <<<"$res")
    if [ "$ok" = "true" ]; then
      jq -r '.result.message_thread_id' <<<"$res"
    else
      echo "tg-topic: create failed: $(jq -r '.description' <<<"$res")" >&2
      exit 1
    fi
    ;;
  post)
    shift
    thread=""
    text=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --thread) thread="$2"; shift 2 ;;
        *) text="$1"; shift ;;
      esac
    done
    [ -n "$thread" ] || { echo "tg-topic: --thread <id> required" >&2; exit 1; }
    [ -n "$text" ] || { echo "tg-topic: text required" >&2; exit 1; }
    curl -fsS "$API/sendMessage" \
      --data-urlencode "chat_id=$CHAT_ID" \
      --data-urlencode "message_thread_id=$thread" \
      --data-urlencode "text=$text" >/dev/null
    ;;
  close)
    shift
    thread=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --thread) thread="$2"; shift 2 ;;
        *) shift ;;
      esac
    done
    [ -n "$thread" ] || { echo "tg-topic: --thread <id> required" >&2; exit 1; }
    curl -fsS "$API/closeForumTopic" \
      --data-urlencode "chat_id=$CHAT_ID" \
      --data-urlencode "message_thread_id=$thread" >/dev/null
    ;;
  list)
    [ -f "$STATE_FILE" ] || { echo "{}" ; exit 0; }
    jq -r --arg pre "${CHAT_ID}:" '
      to_entries
      | map(select(.key | startswith($pre)))
      | map("thread \(.key | split(":")[1]): \(.value[:8])…")
      | .[]
    ' "$STATE_FILE"
    ;;
  ""|-h|--help)
    cat <<EOF
usage:
  tg-topic create "<name>"
  tg-topic post --thread <id> "<text>"
  tg-topic close --thread <id>
  tg-topic list
EOF
    ;;
  *)
    echo "tg-topic: unknown subcommand: $1" >&2
    exit 1
    ;;
esac
